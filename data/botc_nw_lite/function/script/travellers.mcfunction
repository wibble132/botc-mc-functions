give @s written_book[written_book_content={pages:[["",{text:"\n\n   BLOOD ON THE\n    CLOCKTOWER",bold:true,italic:false},"\n",{text:"  \"The Travellers\"",italic:true,color:black},"\n",{text:"ROLE CHEAT SHEET",bold:true,italic:false},"\n",{text:"        v1.0.0",italic:true,color:gray},"\n\n\n\n* next to ability means Not the First Night."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Thief",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Each night, choose a player (not yourself): their vote counts negatively tomorrow."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Bureaucrat",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Each night, choose a player (not yourself): their vote counts as 3 votes tomorrow."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Barista",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Each night, until dusk, 1) a player becomes sober, healthy & gets true info, or 2) their ability works twice. They learn which."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Harlot",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Each night*, choose a living player: if they agree, you learn their character, but you both might die."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Butcher",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Each day, after the 1st execution, you may nominate again."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Cacklejack",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Each day, choose a player: a different player changes character tonight."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Gunslinger",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Each day, after the 1st vote has been tallied, you may choose a player that voted: they die."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Matron",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Each day, you may choose up to 3 sets of 2 players to swap seats. Players may not leave their seats to talk in private."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Gangster",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Once per day, you may choose to kill an alive neighbor, if your other alive neighbor agrees."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Bone Collector",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Once per game, at night*, choose a dead player: they regain their ability until dusk."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Judge",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Once per game, if another player nominated, you may choose to force the current execution to pass or fail."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Apprentice",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"On your 1st night, you gain a Townsfolk ability (if good), or a Minion ability (if evil)."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Beggar",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"You must use a vote token to vote. If a dead player gives you theirs, you learn their alignment. You are sober & healthy."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Deviant",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"If you were funny today, you cannot die by exile."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Scapegoat",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"If a player of your alignment is executed, you might be executed instead."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Gnome",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"All players start knowing a player of your alignment. You may choose to kill anyone who nominates them."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Bishop",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Only the Storyteller can nominate. At least 1 opposing player must be nominated each day."],["","      ",{text:"TRAVELLER",bold:true,italic:false,color:gray},"\n\n",{text:"Voudon",italic:false,underlined:true,color:gray},{text:":\n",italic:false,color:gray},"Only you & the dead can vote. They don't need a vote token to do so. A 50% majority isn't required."]],title:"The Travellers Roles",author:""},custom_name={text:"The Travellers Script",bold:true,italic:false,underlined:true,color:black},lore=[{text:"Useful role cheat sheet for ",italic:false,color:gray},[{text:"The Travellers",italic:false,color:black},{text:" script.",italic:false,color:gray}]]]