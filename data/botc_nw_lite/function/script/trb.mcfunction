give @s written_book[written_book_content={pages:[["",{text:"\n\n   BLOOD ON THE\n    CLOCKTOWER",bold:true,italic:false},"\n",{text:"  \"Trouble Butlering\"",italic:true,color:dark_red,click_event:{action:open_url,url:"https://scripts.botc.ink/script/trb/1.0.0"}},"\n",{text:"ROLE CHEAT SHEET",bold:true,italic:false},"\n",{text:"        v1.0.0",italic:true,color:gray},"\n\n\n\n* next to ability means Not the First Night."],["",{text:"      Contents\n",bold:true,italic:false},"\n",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue},"\n",{text:"Butler chef",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:5}},"\n",{text:"Washer Butler",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:6}},"\n",{text:"Butler investigator",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:7}},"\n",{text:"Butler librarian",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:8}},"\n",{text:"Butler teller",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:9}},"\n",{text:"Butler path",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:10}},"\n",{text:"Butler taker",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:11}},"\n",{text:"Butler monk",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:12}},"\n",{text:"Butler slayer",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:13}},"\n",{text:"Butler Soldier",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:14}},"\n",{text:"Butler keeper",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:15}}],["",{text:"      Contents\n",bold:true,italic:false},"\n",{text:"Butler mayor",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:16}},"\n",{text:"Virgin Butler",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:17}},"\n","","\n",{text:"OUTSIDER",bold:true,italic:false,color:dark_blue},"\n",{text:"Qutler",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:18}},"\n",{text:"Drunk Butler",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:19}},"\n",{text:"Recluse Butler",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:20}},"\n",{text:"Butler saint",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:21}},"\n","","\n",{text:"MINION",bold:true,italic:false,color:dark_red},"\n",{text:"Butler poisoner",italic:false,underlined:true,color:dark_red,click_event:{action:change_page,page:22}},"\n",{text:"Butler spy",italic:false,underlined:true,color:dark_red,click_event:{action:change_page,page:23}}],["",{text:"      Contents\n",bold:true,italic:false},"\n",{text:"Butler woman",italic:false,underlined:true,color:dark_red,click_event:{action:change_page,page:24}},"\n",{text:"Butler baron",italic:false,underlined:true,color:dark_red,click_event:{action:change_page,page:25}},"\n","","\n",{text:"DEMON",bold:true,italic:false,color:dark_red},"\n",{text:"Butler imp",italic:false,underlined:true,color:dark_red,click_event:{action:change_page,page:26}},"\n","","\n",{text:"LORIC",bold:true,italic:false,color:dark_green},"\n",{text:"Master Butler (optional)",italic:false,underlined:true,color:dark_green,click_event:{action:change_page,page:27}},"\n",{text:"Bootlegger 1",italic:false,underlined:true,color:dark_green,click_event:{action:change_page,page:28}},"\n",{text:"Bootlegger 2",italic:false,underlined:true,color:dark_green,click_event:{action:change_page,page:29}},"\n",{text:"Bootlegger 3",italic:false,underlined:true,color:dark_green,click_event:{action:change_page,page:30}}],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler chef",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"You start knowing pairs of evil players there are. You may only vote if a pair of people vote too."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Washer Butler",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"You start knowing that 1 of 2 players is a particular Townsfolk. You may only vote if none of them votes."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler investigator",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"You start knowing that 1 of 2 players is a particular Minion. You can only vote if one of them is voting too."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler librarian",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"You start knowing that 1 of 2 players is a particular Outsider. You may only vote if 1 and only one of them is voting too."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler teller",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Each night, choose two players: learn if either is evil, you may only vote if you learn no."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler path",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Each night, you learn how many of your 2 alive neighbors are evil. You can only vote if both of them are voting too."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler taker",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Each night*, you learn which character died by execution today. You may only vote if a dead player is voting too."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler monk",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Each night*, choose a player (not yourself): they are safe from the Demon tonight. You may only vote if the protected player is voting too."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler slayer",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Once per game, during the day, publicly choose a player: if they are the Demon, they die. You may only vote if the player you tried to shoot votes too."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler Soldier",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"You are safe from the demon. You can only vote if nobody dies."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler keeper",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"If you die at night, you are woken to choose a player: you learn their character. You may only vote if a neighbour died today."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler mayor",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"If only 3 players live & no execution occurs, your team wins. If you die at night, another player might die instead. You may only vote if there are 3 players alive."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Virgin Butler",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"The 1st time you are nominated, if the nominator is a Townsfolk, they are executed immediately. You may only vote if someone nominated you today."],["","      ",{text:"OUTSIDER",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Qutler",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Each night, choose a player (not yourself): tomorrow, you may only vote if they are voting too"],["","      ",{text:"OUTSIDER",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Drunk Butler",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"You think you're a townsfolk but you're not, you are the drunk. You have the same voting restriction as the townsfolk you think you are."],["","      ",{text:"OUTSIDER",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Recluse Butler",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"You might register as evil & as a Minion or Demon, even if dead. You may only vote if 2 or more people are voting."],["","      ",{text:"OUTSIDER",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler saint",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"If you die by execution your team loses, you may only vote for yourself"],["","      ",{text:"MINION",bold:true,italic:false,color:dark_red,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler poisoner",italic:false,underlined:true,color:dark_red},{text:":\n",italic:false,color:dark_red},"Each night, choose a player: they are poisoned tonight and tomorrow day (they keep their voting restriction). You may only vote if your target voted too."],["","      ",{text:"MINION",bold:true,italic:false,color:dark_red,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler spy",italic:false,underlined:true,color:dark_red},{text:":\n",italic:false,color:dark_red},"Each night, you see the Grimoire. You might register as good & as a Townsfolk or Outsider, even if dead. You may only vote if an evil player is also voting."],["","      ",{text:"MINION",bold:true,italic:false,color:dark_red,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler woman",italic:false,underlined:true,color:dark_red},{text:":\n",italic:false,color:dark_red},"If there are 5 or more players alive & the Demon dies, you become the Demon. (Travellers don't count). You may only vote if the demon votes."],["","      ",{text:"MINION",bold:true,italic:false,color:dark_red,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler baron",italic:false,underlined:true,color:dark_red},{text:":\n",italic:false,color:dark_red},"There are extra Outsiders in play. You may only vote if 2 or more players are voting too. [+2 Outsiders]"],["","      ",{text:"DEMON",bold:true,italic:false,color:dark_red,click_event:{action:change_page,page:2}},"\n\n",{text:"Butler imp",italic:false,underlined:true,color:dark_red},{text:":\n",italic:false,color:dark_red},"Each night*, choose a player: they die. If you kill yourself this way, a Minion becomes the Imp. You don't have any voting restrictions."],["","      ",{text:"LORIC",bold:true,italic:false,color:dark_green,click_event:{action:change_page,page:2}},"\n\n",{text:"Master Butler (optional)",italic:false,underlined:true,color:dark_green},{text:":\n",italic:false,color:dark_green},"Each night* tell a player they are the master, they have no voting restriction for tonight."],["","      ",{text:"LORIC",bold:true,italic:false,color:dark_green,click_event:{action:change_page,page:2}},"\n\n",{text:"Bootlegger 1",italic:false,underlined:true,color:dark_green},{text:":\n",italic:false,color:dark_green},"It's still rule breaking to vote when you're not supposed to, but if you do something bad might happen (death or team loss). Please be nice to the storyteller and admit if you break a voting rule"],["","      ",{text:"LORIC",bold:true,italic:false,color:dark_green,click_event:{action:change_page,page:2}},"\n\n",{text:"Bootlegger 2",italic:false,underlined:true,color:dark_green},{text:":\n",italic:false,color:dark_green},"Dead players keep their last voting restriction."],["","      ",{text:"LORIC",bold:true,italic:false,color:dark_green,click_event:{action:change_page,page:2}},"\n\n",{text:"Bootlegger 3",italic:false,underlined:true,color:dark_green},{text:":\n",italic:false,color:dark_green},"When voting starts, you can't change your vote, unless you're breaking your voting restriction then you have to change it. You can break your voting restriction before the countdown starts"]],title:"",author:""},custom_name={text:"Trouble Butlering Script",bold:true,italic:false,underlined:true,color:dark_red},lore=[{text:"Useful role cheat sheet for ",italic:false,color:gray},[{text:"Trouble Butlering",italic:false,color:dark_red},{text:" script.",italic:false,color:gray}]]]