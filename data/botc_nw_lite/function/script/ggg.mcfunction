give @s written_book[written_book_content={pages:[["",{text:"\n\n   BLOOD ON THE\n    CLOCKTOWER",bold:true,italic:false},"\n",{text:"  \"Gaslight, Gatekeep, Giggle\"",italic:true,color:light_purple},"\n",{text:"ROLE CHEAT SHEET",bold:true,italic:false},"\n",{text:"        v1.0.0",italic:true,color:gray},"\n\n\n\n* next to ability means Not the First Night."],["",{text:"      Contents\n",bold:true,italic:false},"\n",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue},"\n",{text:"Steward",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:4}},"\n",{text:"High Priestess",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:5}},"\n",{text:"Village Idiot",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:6}},"\n",{text:"Seamstress",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:7}},"\n",{text:"Philosopher",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:8}},"\n","","\n",{text:"OUTSIDER",bold:true,italic:false,color:dark_blue},"\n",{text:"Damsel",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:9}},"\n",{text:"Lunatic",italic:false,underlined:true,color:dark_blue,click_event:{action:change_page,page:10}}],["",{text:"      Contents\n",bold:true,italic:false},"\n",{text:"MINION",bold:true,italic:false,color:dark_red},"\n",{text:"Marionette",italic:false,underlined:true,color:dark_red,click_event:{action:change_page,page:11}},"\n","","\n",{text:"DEMON",bold:true,italic:false,color:dark_red},"\n",{text:"Imp",italic:false,underlined:true,color:dark_red,click_event:{action:change_page,page:12}}],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Steward",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"You start knowing 1 good player."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"High Priestess",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Each night, learn which player the Storyteller believes you should talk to most."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Village Idiot",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Each night, choose a player: you learn their alignment. [+0 to +2 Village Idiots. 1 of the extras is drunk]"],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Seamstress",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Once per game, at night, choose 2 players (not yourself): you learn if they are the same alignment."],["","      ",{text:"TOWNSFOLK",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Philosopher",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"Once per game, at night, choose a good character: gain that ability. If this character is in play, they are drunk."],["","      ",{text:"OUTSIDER",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Damsel",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"All Minions know a Damsel is in play. If a Minion publicly guesses you (once), your team loses."],["","      ",{text:"OUTSIDER",bold:true,italic:false,color:dark_blue,click_event:{action:change_page,page:2}},"\n\n",{text:"Lunatic",italic:false,underlined:true,color:dark_blue},{text:":\n",italic:false,color:dark_blue},"You think you are a Demon, but you are not. The Demon knows who you are & who you choose at night."],["","      ",{text:"MINION",bold:true,italic:false,color:dark_red,click_event:{action:change_page,page:2}},"\n\n",{text:"Marionette",italic:false,underlined:true,color:dark_red},{text:":\n",italic:false,color:dark_red},"You think you are a good character, but you are not. The Demon knows who you are. [You neighbor the Demon]"],["","      ",{text:"DEMON",bold:true,italic:false,color:dark_red,click_event:{action:change_page,page:2}},"\n\n",{text:"Imp",italic:false,underlined:true,color:dark_red},{text:":\n",italic:false,color:dark_red},"Each night*, choose a player: they die. If you kill yourself this way, a Minion becomes the Imp."]],title:"Gaslight, Gatekeep, Giggle Roles",author:""},custom_name={text:"Gaslight, Gatekeep, Giggle Script",bold:true,italic:false,underlined:true,color:light_purple},lore=[{text:"Useful role cheat sheet for ",italic:false,color:gray},[{text:"Gaslight, Gatekeep, Giggle",italic:false,color:light_purple},{text:" script.",italic:false,color:gray}]]]